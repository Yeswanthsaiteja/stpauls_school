rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(uid()))
        ? get(/databases/$(database)/documents/users/$(uid())).data
        : null;
    }

    function userRole() {
      let data = getUserData();
      return (data != null && 'role' in data) ? data.role : null;
    }

    function getPhone() {
      return ('phone_number' in request.auth.token) ? request.auth.token.phone_number : '';
    }

    // Admin has full permissions. Bypass using hardcoded phone list or stored role
    function isAdmin() {
      let phone = getPhone();
      return isSignedIn() && (
        userRole() == 'SCHOOL_ADMIN' ||
        userRole() == 'ADMIN' ||
        phone == '+918897245345' ||
        phone == '+916304300354' ||
        phone == '+919949156948' ||
        phone == '+918978186701' ||
        phone == '+919553123327'
      );
    }

    function isStaff() {
      return isSignedIn() && (
        (userRole() != 'PARENT' && userRole() != 'STUDENT' && userRole() != null) ||
        isAdmin()
      );
    }

    function isParent() {
      return isSignedIn() && (userRole() == 'PARENT' || isAdmin());
    }

    // ─── Users collection (login profiles) ───────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn() && (uid() == userId || isAdmin() || isStaff());
      allow create: if isSignedIn() && uid() == userId;
      allow update: if isSignedIn() && (uid() == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // ─── Students ─────────────────────────────────────────────────────────────
    match /students/{studentId} {
      allow read: if isSignedIn(); // Allow signed-in users to read for login phone-to-role lookup
      allow create, update: if isAdmin() || isStaff();
      allow delete: if isAdmin();
    }

    // ─── Employees ────────────────────────────────────────────────────────────
    match /employees/{employeeId} {
      allow read: if isSignedIn(); // Allow signed-in users to read for login phone-to-role lookup
      allow create: if isAdmin();
      allow update: if isAdmin() || (isStaff() && uid() == employeeId);
      allow delete: if isAdmin();
    }

    // ─── Attendance ───────────────────────────────────────────────────────────
    match /attendance/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || isStaff();
      allow delete: if isAdmin();
    }

    // ─── Fees / Payments ─────────────────────────────────────────────────────
    match /fee_categories/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStaff();
    }

    match /fee_installments/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStaff();
    }

    match /fee_concessions/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStaff();
    }

    match /fee_concessions_v2/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStaff();
    }

    match /transactions/{txnId} {
      allow read: if isAdmin() || isStaff() || isParent();
      allow create: if isSignedIn();
      allow update: if isAdmin() || isStaff();
      allow delete: if isAdmin();
    }

    match /expenses/{docId} {
      allow read, write: if isAdmin() || isStaff();
    }

    match /payroll/{docId} {
      allow read: if isAdmin() || isStaff();
      allow write: if isAdmin();
    }

    // ─── Timetable / Academics ────────────────────────────────────────────────
    match /timetables/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStaff();
    }

    match /classes/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStaff();
    }

    match /subjects/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStaff();
    }

    match /topics/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStaff();
    }

    match /lesson_plans/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStaff();
    }

    match /exams/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStaff();
    }

    match /exam_schedule/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStaff();
    }

    match /exam_setup/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStaff();
    }

    match /results/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStaff();
    }

    match /homework/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStaff();
    }

    // ─── Notices / Announcements ──────────────────────────────────────────────
    match /notices/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStaff();
    }

    match /announcements/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStaff();
    }

    match /messages/{docId} {
      allow read, write: if isSignedIn();
    }

    match /diary_entries/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStaff();
    }

    match /gallery/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStaff();
    }

    // ─── Leave requests ───────────────────────────────────────────────────────
    match /leave_requests/{leaveId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin() || isStaff();
      allow delete: if isAdmin();
    }

    // ─── OTP store (temp, backend-written) ────────────────────────────────────
    match /otp_store/{phone} {
      allow read, write: if false; // Only backend service account can access
    }

    // ─── Tenants & Settings ──────────────────────────────────────────────────
    match /tenants/{tenantId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Hostel & Transport ──────────────────────────────────────────────────
    match /hostel_rooms/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStaff();
    }

    match /hostel_allocations/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStaff();
    }

    match /transport_routes/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStaff();
    }

    match /transport_allocations/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStaff();
    }

    match /holidays/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── CRM Support ─────────────────────────────────────────────────────────
    match /crm_tickets/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin() || isStaff() || (isSignedIn() && resource.data.raisedBy == getPhone());
      allow delete: if isAdmin();
    }

    // ─── Notifications ────────────────────────────────────────────────────────
    match /notifications/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ─── Activities ───────────────────────────────────────────────────────────
    match /activities/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStaff();
    }


    // ─── ID Card Configurations ───────────────────────────────────────────────
    match /id_card_configs/{configId} {
      allow read: if isAdmin() || isStaff();
      allow write: if isAdmin() || isStaff();
    }

    // ─── Library ──────────────────────────────────────────────────────────────
    match /library_books/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStaff();
    }

    match /library_issues/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStaff();
    }

    // ─── Catch-all Deny ───────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

